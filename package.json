{
  "name": "mistake-notebook",
  "version": "1.0.0",
  "type": "module",
  "description": "Cross-platform Mistake Notebook with GoodNotes style hierarchy, Git sync, and multi-mode notes",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/index.js\" \"vite --open\"",
    "build": "vite build"
  },
  "keywords": [
    "mistake-notebook",
    "wrong-questions",
    "git-sync",
    "goodnotes-style"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "multer": "^2.4.0",
    "postcss": "^8.5.30",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
